  "item": [
    {
      "name": "1. Generate Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"access_token\", jsonData.access_token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "my-secret",
              "type": "string"
            },
            {
              "key": "username",
              "value": "my-client",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Authorization",
            "value": "Basic <base64(client_id:client_secret)>",
            "disabled": true
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "scope",
              "value": "read"
            }
          ]
        },
        "url": {
          "raw": "https://txn-upi-switch.boltpe.co.in/merchantPay/oauth2/token",
          "protocol": "https",
          "host": [
            "txn-upi-switch",
            "boltpe",
            "co",
            "in"
          ],
          "path": [
            "merchantPay",
            "oauth2",
            "token"
          ]
        }
      },
      "response": []
    },
