package com.auisy.utility;

import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.Base64;

public class SHA256Conversion {

    public static String sha256Base64(String input) throws Exception {

        MessageDigest digest = MessageDigest.getInstance("SHA-256");

        byte[] hash = digest.digest(input.getBytes(StandardCharsets.UTF_8));

        return Base64.getEncoder().encodeToString(hash);
    }

    public static void main(String[] args) {

        try {

            String data = "M0000932026546994443400333500.00gatla_dplnQZ@paytm";

            String checksum = sha256Base64(data);

            System.out.println("SHA-256 Base64 Checksum:");
            System.out.println(checksum);

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}